        <xs:annotation>
          <xs:documentation>Automatically rename the document.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="overwrite">
        <xs:annotation>
          <xs:documentation>Overwrite the exsiting document.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="skip">
